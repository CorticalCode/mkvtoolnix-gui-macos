diff --git a/packaging/macos/build.sh b/packaging/macos/build.sh
index 58d8159..d154840 100755
--- a/packaging/macos/build.sh
+++ b/packaging/macos/build.sh
@@ -422,10 +422,23 @@ function build_mkvtoolnix {
   fi
 
   NO_MAKE=1 NO_CONFIGURE=1 build_package /mkvtoolnix-${MTX_VER}.tar.xz
+
+  # Size optimization for mkvtoolnix only — deps already built at -O2 from
+  # config.local.sh. -flto=thin enables ThinLTO; -Os optimizes for binary size.
+  # Flags must be set before build_configured_mkvtoolnix because autoconf
+  # bakes USER_CXXFLAGS/USER_LDFLAGS into build-config at configure time.
+  local saved_CXXFLAGS=$CXXFLAGS
+  local saved_LDFLAGS=$LDFLAGS
+  export CXXFLAGS="${CXXFLAGS} -flto=thin -Os"
+  export LDFLAGS="${LDFLAGS} -flto=thin"
+
   build_configured_mkvtoolnix
 
   ${RAKE} clean
   ${RAKE} -j ${DRAKETHREADS}
+
+  CXXFLAGS=$saved_CXXFLAGS
+  LDFLAGS=$saved_LDFLAGS
 }
 
